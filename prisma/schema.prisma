// Prisma schema for News and Market Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String?
  url         String
  imageUrl    String?
  source      String
  category    String[]
  keywords    String[]
  language    String   @default("en")
  country     String?
  sentiment   String?  // positive, negative, neutral
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entities    NewsEntity[]

  @@index([publishedAt])
  @@index([source])
  @@index([sentiment])
}

model NewsEntity {
  id        String   @id @default(uuid())
  name      String
  type      String   // person, organization, location, etc.
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime @default(now())

  @@index([name])
  @@index([type])
}

model StockData {
  id        String   @id @default(uuid())
  symbol    String
  name      String?
  price     Float
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  volume    BigInt?
  change    Float?
  changePercent Float?
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([symbol])
  @@index([timestamp])
  @@unique([symbol, timestamp])
}

model WatchlistStock {
  id        String   @id @default(uuid())
  symbol    String   @unique
  name      String
  addedAt   DateTime @default(now())
}
